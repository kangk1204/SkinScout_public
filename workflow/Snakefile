    ("retrieval_ligands", "data/activity_retrieval_20260914_identity/ligands.parquet"),
    ("target_fasta", "data/evidence_splits/target_clusters_aug30_2026_02_all_seqs.fasta"),
    ("target_clusters", "data/evidence_splits/screenable_target_clusters_2026_02.csv"),
    ("evaluation_panel_manifest", "data/activity_recovery_panels_20260914_identity/manifest.json"),
    ("dev_ranking_queries", "data/activity_recovery_panels_20260914_identity/dev_ranking_queries.parquet"),
    ("dev_calibration_pairs", "data/activity_recovery_panels_20260914_identity/dev_calibration_pairs.parquet"),
    ("dual_cold_ranking_queries", "data/activity_recovery_panels_20260914_identity/dual_cold_ranking_queries.parquet"),
    ("output_dir", "data/performance_v2_20260914_identity"),
    ("evaluation_dir", "results/eval/performance_v2_20260914_identity"),
):
    PERFORMANCE_V2[_key] = config_path(
        PERFORMANCE_V2.get(_key, _default),
        f"evaluation.performance_v2.{_key}",
    )
for _key, _default, _minimum in (
    ("ligand_batch_size", 16, 1),
    ("protein_batch_size", 8, 1),
    ("training_batch_size", 2048, 1),
    ("hidden_dim", 512, 1),
    ("epochs", 20, 1),
    ("rerank_top_k", 512, 1),
    ("structure_top_k", 64, 1),
    ("boltz_top_k", 3, 1),
    ("boltz_max_residues", 700, 1),
    ("max_trainable_parameters", 10_000_000, 1),
):
    PERFORMANCE_V2[_key] = config_int(
        PERFORMANCE_V2.get(_key),
        f"evaluation.performance_v2.{_key}",
        _default,
        minimum=_minimum,
    )
PERFORMANCE_V2["learning_rate"] = config_float(
    PERFORMANCE_V2.get("learning_rate"),
    "evaluation.performance_v2.learning_rate",
    0.001,
    minimum=1e-12,
)
PERFORMANCE_V2["max_peak_vram_gib"] = config_float(
    PERFORMANCE_V2.get("max_peak_vram_gib"),
    "evaluation.performance_v2.max_peak_vram_gib",
    11.5,
    minimum=1e-12,
    maximum=11.5,
)
for _key, _expected in (
    ("molformer_checkpoint", "ibm-research/MoLFormer-XL-both-10pct"),
    ("molformer_revision", "compat-v4"),
    ("esm2_checkpoint", "esm2_t30_150M_UR50D"),
    ("esm2_revision", "main"),
):
    PERFORMANCE_V2[_key] = config_text(
        PERFORMANCE_V2.get(_key),
        f"evaluation.performance_v2.{_key}",
        _expected,
    )
    if PERFORMANCE_V2[_key] != _expected:
        raise ValueError(
            f"evaluation.performance_v2.{_key} must remain pinned to {_expected!r}"
        )
if PERFORMANCE_V2["max_trainable_parameters"] > 10_000_000:
    raise ValueError(
        "evaluation.performance_v2.max_trainable_parameters must be <= 10000000"
    )
if not (
    PERFORMANCE_V2["boltz_top_k"]
    <= PERFORMANCE_V2["structure_top_k"]
    <= PERFORMANCE_V2["rerank_top_k"]
):
    raise ValueError(
        "evaluation.performance_v2 budgets must satisfy "
        "boltz_top_k <= structure_top_k <= rerank_top_k"
    )
_performance_v2_seeds = PERFORMANCE_V2.get("seeds", [17, 42, 73])
if _performance_v2_seeds != [17, 42, 73]:
    raise ValueError(
        "evaluation.performance_v2.seeds must remain exactly [17, 42, 73]"
    )
PERFORMANCE_V2["seeds"] = _performance_v2_seeds
