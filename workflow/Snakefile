    250,
    minimum=1,
)
ANALOG_GEN["funnel_boltz"] = config_int(
    ANALOG_GEN.get("funnel_boltz"),
    "analog_gen.funnel_boltz",
    30,
    minimum=1,
)
for _key in (
    "reinvent_executable",
    "reinvent_model_manifest",
    "reinvent_config",
    "reinvent_plugin_manifest",
):
    ANALOG_GEN[_key] = config_text(ANALOG_GEN.get(_key), f"analog_gen.{_key}")
ANALOG_GEN["reinvent_seed"] = config_int(
    ANALOG_GEN.get("reinvent_seed"),
    "analog_gen.reinvent_seed",
    49242,
    minimum=0,
)
ANALOG_GEN["reinvent_timeout_seconds"] = config_int(
    ANALOG_GEN.get("reinvent_timeout_seconds"),
    "analog_gen.reinvent_timeout_seconds",
    3600,
    minimum=1,
)
FINETUNE = ANALOG_GEN.setdefault("finetune", {})
FINETUNE["enabled"] = config_bool(
    FINETUNE.get("enabled"), False, "analog_gen.finetune.enabled"
)
for _key in (
    "train_smiles",
    "holdout_smiles",
    "prior",
    "agent",
    "staged_config",
    "plugin_manifest",
    "command_template",
):
    FINETUNE[_key] = config_text(
        FINETUNE.get(_key), f"analog_gen.finetune.{_key}"
    )
FINETUNE["allow_empty_output"] = config_bool(
    FINETUNE.get("allow_empty_output"),
    False,
    "analog_gen.finetune.allow_empty_output",
)
if FINETUNE["enabled"] and not ANALOG_GEN["enabled"]:
    raise ValueError(
        "analog_gen.finetune.enabled requires analog_gen.enabled=true"
    )
if ANALOG_GEN["enabled"]:
    _missing_reinvent = [
        _key
        for _key in (
            "reinvent_executable",
            "reinvent_config",
            "reinvent_plugin_manifest",
        )
        if not ANALOG_GEN[_key]
    ]
    if not FINETUNE["enabled"] and not ANALOG_GEN["reinvent_model_manifest"]:
        _missing_reinvent.append("reinvent_model_manifest")
    if _missing_reinvent:
        raise ValueError(
            "analog_gen.enabled=true requires pinned REINVENT4 config values: "
            + ", ".join(_missing_reinvent)
        )
    if FINETUNE["enabled"]:
        _missing_finetune = [
            _key
            for _key in (
                "train_smiles",
                "holdout_smiles",
                "prior",
                "agent",
                "staged_config",
                "plugin_manifest",
                "command_template",
            )
            if not FINETUNE[_key]
        ]
        if _missing_finetune:
            raise ValueError(
                "analog_gen.finetune.enabled=true requires frozen fine-tune "
                "config values: " + ", ".join(_missing_finetune)
            )
        if ANALOG_GEN["reinvent_model_manifest"]:
            raise ValueError(
                "analog_gen.reinvent_model_manifest must be empty when "
                "analog_gen.finetune.enabled=true; the fine-tune manifest is "
                "generated inside the run directory"
            )
RETROSYNTHESIS = config_mapping(
    config.get("retrosynthesis"), "retrosynthesis"
)
RETROSYNTHESIS["enabled"] = config_bool(
    RETROSYNTHESIS.get("enabled"), False, "retrosynthesis.enabled"
)
RETROSYNTHESIS["executable"] = config_text(
    RETROSYNTHESIS.get("executable"), "retrosynthesis.executable", "aizynthcli"
)
for _key in ("config", "model_manifest", "stock_manifest"):
    RETROSYNTHESIS[_key] = config_text(
        RETROSYNTHESIS.get(_key), f"retrosynthesis.{_key}"
    )
RETROSYNTHESIS["iteration_limit"] = config_int(
    RETROSYNTHESIS.get("iteration_limit"),
    "retrosynthesis.iteration_limit",
    100,
    minimum=1,
)
RETROSYNTHESIS["time_limit_s"] = config_int(
    RETROSYNTHESIS.get("time_limit_s"),
    "retrosynthesis.time_limit_s",
    120,
    minimum=1,
)
RETROSYNTHESIS["max_transforms"] = config_int(
    RETROSYNTHESIS.get("max_transforms"),
    "retrosynthesis.max_transforms",
    6,
    minimum=1,
)
if RETROSYNTHESIS["enabled"]:
    _missing_aizynth = [
        _key
        for _key in ("config", "model_manifest", "stock_manifest")
        if not RETROSYNTHESIS[_key]
    ]
    if _missing_aizynth:
        raise ValueError(
            "retrosynthesis.enabled=true requires pinned AiZynthFinder assets: "
            + ", ".join(_missing_aizynth)
        )

os.makedirs(MANIFESTS, exist_ok=True)
os.makedirs(RUN_DIR, exist_ok=True)


# --- Wildcard helpers --------------------------------------------------------
def uniprot_ids():
    """Return list of cleaned UniProt IDs in data/human_clean/.

    Returns [] before Stage 0 has been built so the DAG can still be parsed.
    """
    clean = Path(config["paths"]["alphafold_clean"])
    if not clean.exists():
        return []
    return sorted(p.stem.removesuffix("_clean") for p in clean.glob("*_clean.pdb"))

