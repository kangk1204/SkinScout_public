def validated_rrf_weights(value, label, expected_labels):
    weights = config_mapping(value, label)
    actual_labels = set(weights)
    expected_labels = set(expected_labels)
    if actual_labels != expected_labels:
        missing = sorted(expected_labels - actual_labels)
        extra = sorted(actual_labels - expected_labels)
        raise ValueError(
            f"{label} labels must exactly match scorer labels; "
            f"missing={missing} extra={extra}"
        )
    return {
        source: config_float(
            weights[source],
            f"{label}.{source}",
            1.0,
            minimum=1e-12,
        )
        for source in sorted(expected_labels)
    }


DOCKING["comprehensive_rrf_source_weights"] = validated_rrf_weights(
