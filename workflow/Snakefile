import math
import os
import re
import shlex
import shutil
from pathlib import Path
from urllib.parse import urlparse

configfile: "workflow/config.yaml"

DOI_RE = re.compile(r"^10\.\d{4,9}/[-._;()/:A-Z0-9]+$", re.IGNORECASE)
RUN_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")


def config_bool(value, default=False, name=None):
    """Parse config booleans from YAML or CLI overrides."""
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        normalized = value.strip().lower()
        if normalized in {"1", "true", "yes", "y", "on"}:
            return True
        if normalized in {"0", "false", "no", "n", "off"}:
            return False
    label = f" '{name}'" if name else ""
    raise ValueError(
        f"Config boolean{label} must be one of true/false, yes/no, on/off, "
        f"or 1/0: {value!r}"
    )


def config_float(value, name, default, minimum=None, maximum=None):
    """Parse numeric config values from YAML or CLI overrides."""
    if value is None:
        value = default
    if isinstance(value, bool):
        raise ValueError(
            f"Config value '{name}' must be a finite number in "
            f"[{minimum}, {maximum}]: {value!r}"
        )
    try:
        parsed = float(value)
    except (TypeError, ValueError, OverflowError) as exc:
        raise ValueError(
            f"Config value '{name}' must be a finite number in "
            f"[{minimum}, {maximum}]: {value!r}"
        ) from exc
    if (
        not math.isfinite(parsed)
        or (minimum is not None and parsed < minimum)
        or (maximum is not None and parsed > maximum)
    ):
        raise ValueError(
            f"Config value '{name}' must be a finite number in "
            f"[{minimum}, {maximum}]: {value!r}"
        )
    if isinstance(value, (int, float)):
        return value
    return parsed


def config_int(value, name, default, minimum=None, maximum=None):
    """Parse integer config values from YAML or CLI overrides."""
    if value is None:
        value = default
    if isinstance(value, bool):
        raise ValueError(
            f"Config value '{name}' must be an integer in "
            f"[{minimum}, {maximum}]: {value!r}"
        )
    try:
        parsed = int(value)
    except (TypeError, ValueError, OverflowError) as exc:
        raise ValueError(
            f"Config value '{name}' must be an integer in "
            f"[{minimum}, {maximum}]: {value!r}"
        ) from exc
    if isinstance(value, float) and not value.is_integer():
        raise ValueError(
            f"Config value '{name}' must be an integer in "
            f"[{minimum}, {maximum}]: {value!r}"
        )
    if (
        (minimum is not None and parsed < minimum)
        or (maximum is not None and parsed > maximum)
    ):
        raise ValueError(
            f"Config value '{name}' must be an integer in "
            f"[{minimum}, {maximum}]: {value!r}"
        )
    return parsed


def config_choice(value, name, choices, default=None):
    """Parse enumerated config values from YAML or CLI overrides."""
    if value is None:
        value = default
    text = str(value or "").strip()
    allowed = sorted(choices)
    if text not in choices:
        raise ValueError(
            f"Config value '{name}' must be one of {', '.join(allowed)}: "
            f"{value!r}"
        )
    return text


def config_text(value, name, default=""):
    """Normalize free-text CLI/config values that may be omitted."""
    if value is None:
        value = default
    text = str(value).strip()
    return text


def config_mapping(value, name):
    """Require a YAML mapping for nested configuration sections."""
    if not isinstance(value, dict):
        raise ValueError(
            f"Config section '{name}' must be a mapping/object: {value!r}"
        )
    return value


def config_run_id(value):
    """Validate run identifiers before they are interpolated into paths."""
    text = config_text(value, "run_id")
    if text in {"", ".", ".."} or not RUN_ID_RE.fullmatch(text):
        raise ValueError(
            "Config value 'run_id' must be a safe run identifier using only "
            f"letters, numbers, '.', '_' and '-': {value!r}"
        )
    return text


def config_path(value, name):
    """Validate path-like config values without touching the filesystem."""
    text = config_text(value, name)
    if not text or "\x00" in text or "\n" in text or "\r" in text:
        raise ValueError(f"Config path '{name}' must be a non-empty path: {value!r}")
    if "://" in text:
        raise ValueError(f"Config path '{name}' must be a filesystem path: {value!r}")
    return text


def config_date(value, name, default):
    """Validate YYYY-MM-DD date strings used by leakage/evaluation gates."""
    text = str(value if value is not None else default).strip()
    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
        raise ValueError(
            f"Config date '{name}' must use YYYY-MM-DD format: {value!r}"
        )
    return text


def config_sha256(value, name):
    """Validate pinned artifact digests before they reach download rules."""
    text = config_text(value, name)
    if not re.fullmatch(r"[0-9a-f]{64}", text):
        raise ValueError(
            f"Config sha256 '{name}' must be 64 lowercase hex characters: {value!r}"
        )
    return text


def config_github_url(value, name, default):
    """Validate public repository URLs used in publication provenance."""
    text = str(value if value is not None else default).strip()
    parsed = urlparse(text)
    path_parts = [part for part in parsed.path.split("/") if part]
    if parsed.scheme == "https" and parsed.netloc == "github.com" and len(path_parts) >= 2:
        return text
    raise ValueError(
        f"Config URL '{name}' must use http(s) and point to "
        f"github.com/<owner>/<repo>: {value!r}"
    )


def config_doi(value, name, *, draft_ok=False, required=False):
    """Validate DOI strings for claim-quality publication output."""
    text = str(value if value is not None else "pending").strip()
    if DOI_RE.fullmatch(text) and "XXXX" not in text.upper():
        return text
    if text == "pending" and (draft_ok or not required):
        return text
    raise ValueError(
        f"Config DOI '{name}' must be a real DOI for claim-quality "
        "publication output; set draft_doi_ok=true only for explicit drafts: "
        f"{value!r}"
    )


