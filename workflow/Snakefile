def mode_targets():
    """Return the set of files that 'all' should produce for the chosen mode."""
    report_html = RUN_DIR / "09_report" / "index.html"
    targets = [str(report_html)]
    if MODE in ("comprehensive", "both"):
        targets.append(str(RUN_DIR / "03_targets" / "mode_comprehensive" / "top50_4way_consensus.csv"))
        if RUN_DTI:
            targets.append(str(RUN_DIR / "03_targets" / "mode_comprehensive" / "disagreement_analysis.json"))
    if MODE in ("fast", "both"):
        targets.append(str(RUN_DIR / "03_targets" / "mode_fast" / "top50.csv"))
        targets.append(
            str(RUN_DIR / "03_targets" / "mode_fast" / "top50_band_reranked.csv")
        )
    # v3 skin-weighted ranking — produced whenever the skin weight is non-zero,
    # i.e. cosmetic-domain runs. Set skin_weight=0 in config to opt out.
    if V3_TARGET_WEIGHT_ENABLED:
        targets.append(str(RUN_DIR / "03_targets" / "ranked_targets_v3_with_efficacy.csv"))
    if config_bool(ANALOG_GEN.get("enabled"), False):
        targets.append(str(S56_DIR / "top30_analogs.sdf"))
    if config_bool(RETROSYNTHESIS.get("enabled"), False):
        targets.append(str(S75_DIR / "synthesis_priority_ranking.csv"))
    if config_bool(PUBLICATION.get("build_publication_package"), False):
        targets.extend([
            str(RUN_DIR / "publication" / "figures" / "captions.json"),
            str(RUN_DIR / "publication" / "data_availability.md"),
            str(RUN_DIR / "publication" / "reproducibility" / "artifact_manifest.json"),
            str(RUN_DIR / "publication" / "claim_manifest.json"),
        ])
        if config_bool(PUBLICATION.get("emit_manuscript_draft"), False):
            targets.append(str(RUN_DIR / "publication" / "manuscript_draft" / "02_methods.md"))
    if config_bool(ACTIVITY_RETRIEVAL.get("required"), True):
        targets.append(str(MANIFESTS / "activity_retrieval_operational_gate.flag"))
    if PERFORMANCE_V2["enabled"]:
        targets.extend([
            str(PV2_RUN / "ranked_targets_v3_with_efficacy_and_performance_v2.csv"),
            str(PV2_RUN / "attachment.manifest.json"),
        ])
    return targets

rule all:
    input:
        mode_targets()

rule stage0_complete:
    input:
        str(MANIFESTS / "stage0_complete.flag")

rule clean_run:
    """Wipe a specific run dir (use --config run_id=...)."""
    run:
        results_root = RESULTS.resolve()
        run_dir = RUN_DIR.resolve()
        if run_dir == results_root or run_dir.parent != results_root:
            raise ValueError(
                f"Refusing to clean path outside the configured results root: {run_dir}"
            )
        if RUN_DIR.is_symlink():
            raise ValueError(f"Refusing to clean a symlinked run directory: {RUN_DIR}")
        if RUN_DIR.exists():
            shutil.rmtree(RUN_DIR)
        RUN_DIR.mkdir(parents=True, exist_ok=False)
