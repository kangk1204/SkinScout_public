# Stage 3 output directories are shared by the comprehensive path, the fast path
# and the skin-weighting rules. They lived in stage3a_comprehensive.smk, which
# made the include order circular once stage3_v3_skin_weight had to come first.
S3C_DIR = RUN_DIR / "03_targets" / "mode_comprehensive"
S3F_DIR = RUN_DIR / "03_targets" / "mode_fast"

# stage3b_fast and stage3_v3_skin_weight both reference rules.known_target_prior,
# which stage3_v3_skin_weight defines. With it included last, Snakemake could not
# parse the workflow in any mode - fast or comprehensive - so nothing ran at all.
# It depends only on stage2_5 rules, so it is safe ahead of the stage 3 paths.
include: "rules/stage3_v3_skin_weight.smk"
