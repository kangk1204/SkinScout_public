{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skinscout.local/schemas/run_manifest_v3.json",
  "title": "SkinScout Run Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_profile",
    "recipe_id",
    "hashes",
    "artifact_ids",
    "target_fast"
  ],
  "properties": {
    "schema_version": {"const": "skinscout.run_manifest.v3"},
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "run_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_preset",
        "normalized_preset",
        "execution_mode",
        "analysis_profile",
        "evidence_mode",
        "context_profile",
        "sota_claim"
      ],
      "properties": {
        "requested_preset": {
          "enum": ["stage0", "safety", "target-id", "report", "target-id-sota", "report-sota"]
        },
        "normalized_preset": {"enum": ["stage0", "safety", "target-id", "report"]},
        "execution_mode": {"enum": ["fast", "comprehensive", "both"]},
        "analysis_profile": {
          "enum": [
            "stage0",
            "safety",
            "target_fast",
            "target_comprehensive",
            "target_compare",
            "report_fast",
            "physics_full"
          ]
        },
        "evidence_mode": {"enum": ["evidence", "discovery"]},
        "context_profile": {
          "enum": [
            "auto",
            "general_skin",
            "pigmentation",
            "anti_aging",
            "barrier",
            "acne",
            "inflammation",
            "irritation_sensitization"
          ]
        },
        "sota_claim": {"type": "boolean"}
      }
    },
    "recipe_id": {"const": "daina-structural-overlay-v1"},
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_sha256",
        "config_sha256",
        "image_sha256",
        "data_sha256",
        "target_fast_schema_sha256"
      ],
      "properties": {
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "image_sha256": {"$ref": "#/$defs/nullableSha256"},
        "data_sha256": {"$ref": "#/$defs/nullableSha256"},
        "target_fast_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast_artifact_id",
        "physics_artifact_id",
        "expected_fast",
        "expected_physics"
      ],
      "properties": {
        "fast_artifact_id": {"const": "target_fast_daina_structural_targets"},
        "physics_artifact_id": {"type": ["string", "null"], "minLength": 1},
        "expected_fast": {
          "type": "array",
          "prefixItems": [{"const": "target_fast_daina_structural_targets"}],
          "minItems": 1,
          "maxItems": 1
        },
        "expected_physics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "target_fast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_id",
        "path",
        "sha256",
        "compatibility_projection"
      ],
      "properties": {
        "schema_version": {"const": "skinscout.target_fast.v2"},
        "artifact_id": {"const": "target_fast_daina_structural_targets"},
        "path": {"const": "03_targets/mode_fast/daina_structural_targets.csv"},
        "sha256": {"$ref": "#/$defs/nullableSha256"},
        "compatibility_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "path", "sha256"],
          "properties": {
            "artifact_id": {"const": "target_fast_top50_compat"},
            "path": {"const": "03_targets/mode_fast/top50.csv"},
            "sha256": {"$ref": "#/$defs/nullableSha256"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    }
  }
}
